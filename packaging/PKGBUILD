# Maintainer: uniwidged contributors <noreply@example.invalid>
#
# Written against makepkg's documented behaviour and *not* built by this
# project's CI — see packaging/README.md. Run `makepkg -si` locally before
# publishing anything from it.
pkgname=uniwidged
pkgver=0.0.1
pkgrel=1
pkgdesc="Cross-platform desktop widget framework: sandboxed WASM widgets on the desktop layer"
arch=('x86_64' 'aarch64')
url="https://github.com/j-pfalzgraf/uniwidged"
license=('MIT' 'Apache-2.0')
# libxcb because the X11 surface is created through it — wgpu needs a real
# xcb_connection_t*, which a pure-Rust connection has no pointer to give it.
depends=('libxcb' 'gcc-libs')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    # Vendored and locked, so the build is the one that was tested.
    cargo fetch --locked
}

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --frozen --package uniwidged-cli
}

check() {
    cd "$pkgname-$pkgver"
    # The GPU, X11 and Wayland tests skip themselves where the session is
    # missing, which on a build machine is all of them; what runs here is the
    # capability, manifest, registry and signature logic — the security
    # boundary, and the part a packager most wants to have run.
    cargo test --frozen --workspace
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/uniwidged" "$pkgdir/usr/bin/uniwidged"
    install -Dm644 "packaging/uniwidged.1" "$pkgdir/usr/share/man/man1/uniwidged.1"
    install -Dm644 "packaging/uniwidged.desktop" \
        "$pkgdir/usr/share/applications/uniwidged.desktop"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
